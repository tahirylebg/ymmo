# Copy this file to .env and adjust the values. Never commit .env.

# --- Application ---
APP_ENV=development
APP_DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- PostgreSQL (used by docker compose) ---
POSTGRES_USER=ymmo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ymmo
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Seed ---
# Load demo data (agencies, users, properties, sales history) at startup when the DB is empty
SEED_ON_STARTUP=true
